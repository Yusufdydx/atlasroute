# Environment Variables Configuration
# Copy this file to .env and fill in your values

# OpenRouteService API Key (required for routing/distance calculations)
# Get your free key at: https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# Nominatim Email (required by Nominatim's usage policy)
# Enter your email so they can contact you if needed
NOMINATIM_EMAIL=your_email@example.com

# Optional: Custom User-Agent for Nominatim requests
NOMINATIM_USER_AGENT=PO-MCP-Server/1.0

# Optional: Custom Overpass API endpoint (default is the public one)
# OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Server Port (optional, defaults to 5000)
# PORT=5000

# Environment: dev, prod, or leave empty for localhost
# PO_ENV=dev

# Allow all hosts (set to true for ngrok or custom domains)
ALLOW_ALL_HOSTS=true
